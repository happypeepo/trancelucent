# Copy to .env and fill in. .env is gitignored.
# Load it before starting the server:   set -a; source .env; set +a
GEMINI_API_KEY=
# Optional extra keys (ideally from separate Google AI Studio projects, so quotas
# are actually additive). gemini.py falls back to GEMINI_API_KEY_2, _3, ... in
# order whenever a call hits a 429 RESOURCE_EXHAUSTED on the current key.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
CLARITY_PROJECT_ID=
# Optional: override if Vercel gives this project a unique analytics script path.
VERCEL_ANALYTICS_SCRIPT_SRC=/_vercel/insights/script.js
# Optional: the building chat (CometChat). Leave blank and the chat tab says it isn't set up.
# The REST key stays on the server; the page only ever receives a per-visitor login pass.
COMETCHAT_APP_ID=
COMETCHAT_REGION=
COMETCHAT_REST_KEY=
